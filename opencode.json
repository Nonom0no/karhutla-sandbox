{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "npm run *": "allow",
      "npm ci": "allow",
      "npm install*": "ask",
      "pip install*": "ask",
      "pytest*": "allow",
      "ruff *": "allow",
      "grep *": "allow",
      "rm *": "deny"
    },
    "edit": "allow"
  }
}
